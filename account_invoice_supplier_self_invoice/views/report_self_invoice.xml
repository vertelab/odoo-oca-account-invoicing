<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Self invoice layout view -->
    <template
        id="external_layout_striped_self_invoice"
        inherit_id="web.external_layout_striped"
        primary="True"
        priority="99"
    >
        <!-- HEADER -->
        <xpath
            expr="//div[@t-attf-class='o_company_#{company.id}_layout header']/div[hasclass('d-flex')]"
            position="replace"
        >
            <div class="d-flex">
                <div>
                    <img
                        t-if="o.partner_id.image_1024"
                        t-att-src="image_data_uri(o.partner_id.image_1024)"
                        class="o_company_logo_big"
                        alt="Logo"
                    />
<!--                    <div-->
<!--                        t-if="o.partner_id.self_invoice_report_header"-->
<!--                        t-field="o.partner_id.self_invoice_report_header"-->
<!--                        class="o_company_tagline fw-bold mt-2"-->
<!--                    />-->
                </div>

                <div class="w-50 ms-3" name="company_address">
                    <ul class="list-unstyled" name="company_address_list">
                        <li t-if="o.partner_id">
                            <span
                                t-field="o.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'
                            />
                        </li>
                        <li t-if="o.partner_id.vat">
                            <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                            <span t-field="o.partner_id.vat"/>
                        </li>
                    </ul>
                </div>
            </div>
        </xpath>
        <!-- FOOTER -->
        <xpath
            expr="//div[contains(@t-attf-class, 'footer')]/div[hasclass('o_footer_content')]"
            position="replace"
        >
            <div class="o_footer_content border-top pt-2 text-center">
                <div t-field="o.partner_id.self_invoice_report_footer"/>
                <div t-if="o.state != 'posted'" class="text-danger mt-2">
                    <strong>This Self-bill is not valid</strong>
                </div>
                <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted" t-out="o.name">(document name)</div>
                <div t-if="report_type == 'pdf'" class="text-muted">Page <span class="page"/> / <span class="topage"/></div>
            </div>
        </xpath>
    </template>

    <!-- External layout view: self invoice layout switcher -->
    <template
        id="external_layout_self_invoice"
        inherit_id="web.external_layout"
        priority="99"
    >
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="replace">
            <t t-if="company.external_report_layout_id">
                <t
                    t-if="is_self_invoice"
                    t-call="account_invoice_supplier_self_invoice.external_layout_striped_self_invoice"
                >
                    <t t-out="0" />
                </t>
                <t t-else="" t-call="{{company.external_report_layout_id.sudo().key}}">
                    <t t-out="0" />
                </t>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='web.external_layout_standard']" position="replace">
            <t t-else="else">
                <t
                    t-if="is_self_invoice"
                    t-call="account_invoice_supplier_self_invoice.external_layout_striped_self_invoice"
                >
                    <t t-out="0" />
                </t>
                <t t-else="" t-call="web.external_layout_standard">
                    <t t-out="0" />
                </t>
            </t>
        </xpath>
    </template>

    <!-- Report view: Invoice document -->
    <template
        id="report_invoice_document_self_invoice"
        inherit_id="account.report_invoice_document"
        priority="99"
    >
        <!-- Address switcher -->
        <xpath
            expr="//div[@name='address_same_as_shipping']/t[@t-set='address']"
            position="after"
        >
            <t t-if="o.set_self_invoice">
                <t t-set="address">
                    <address
                        class="mb-0"
                        t-field="o.company_id.partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
                    />
                    <div t-if="o.company_id.partner_id.vat">
                        <t
                            t-if="o.company_id.account_fiscal_country_id.vat_label"
                            t-out="o.company_id.account_fiscal_country_id.vat_label"
                            id="inv_tax_id_label"
                        />
                        <t t-else="">Tax ID</t>: <span t-field="o.company_id.partner_id.vat"/>
                    </div>
                </t>
            </t>
        </xpath>

        <!-- Move type text - Vendor Credit Note -->
        <xpath expr="//t[@t-set='layout_document_title']//span[5]" position="replace">
            <span t-if="not o.set_self_invoice and o.move_type == 'in_refund'">Vendor Credit Note</span>
        </xpath>

        <!-- Move type text - Vendor Bill -->
        <xpath expr="//t[@t-set='layout_document_title']//span[6]" position="replace">
            <span t-if="not o.set_self_invoice and o.move_type == 'in_invoice'">Vendor Bill</span>
        </xpath>

        <!-- Document number/name -->
        <xpath
            expr="//t[@t-set='layout_document_title']//span[@t-field='o.name']"
            position="replace"
        >
            <span t-if="o.set_self_invoice and o.move_type == 'in_refund'">Self-bill Credit Note</span>
            <span t-if="o.set_self_invoice and o.move_type == 'in_invoice'">Self-bill Invoice</span>
            <span t-if="not o.set_self_invoice and o.name and o.name != '/'" t-field="o.name"/>
            <span t-if="o.set_self_invoice and o.ref and o.ref != '/'" t-field="o.ref"/>
        </xpath>

        <!-- Invoice date text -->
        <xpath
            expr="//div[@id='informations']//div[@name='invoice_date']//t[@t-else='']"
            position="before"
        >
            <t t-elif="o.set_self_invoice and o.move_type == 'in_invoice'">
                <strong>Invoice Date</strong>
            </t>
            <t t-elif="o.set_self_invoice and o.move_type == 'in_refund'">
                <strong>Credit Note Date</strong>
            </t>
            <t t-elif="o.set_self_invoice and o.move_type == 'in_receipt'">
                <strong>Receipt Date</strong>
            </t>
        </xpath>

        <!-- Due date -->
        <xpath
            expr="//div[@id='informations']//div[@name='due_date']"
            position="attributes"
        >
            <attribute name="t-if">o.invoice_date_due and (o.move_type == 'out_invoice' or (o.move_type == 'in_invoice' and o.set_self_invoice)) and o.state == 'posted'</attribute>
        </xpath>

        <!-- Reference -->
        <xpath
            expr="//div[@id='informations']//div[@name='reference']"
            position="attributes"
        >
            <attribute name="t-if">o.ref and (o.move_type not in ('in_invoice', 'in_refund') or not o.set_self_invoice)</attribute>
        </xpath>
    </template>

    <!-- Report: Invoices with payments -->
<!--    <template id="report_self_invoice_report" inherit_id="account.report_invoice">-->
<!--        <xpath expr="//t[@t-foreach='docs']" position="inside">-->
<!--            <t t-set="is_self_invoice" t-value="o.set_self_invoice" />-->
<!--        </xpath>-->
<!--    </template>-->

    <template
        id="report_self_invoice_with_payments"
        inherit_id="account.report_invoice_with_payments"
    >
        <xpath expr="//t[@t-call='account.report_invoice']" position="inside">
            <t t-set="is_self_invoice" t-value="True" />
        </xpath>
    </template>

    <!-- Report: Invoices without payments -->
    <template id="report_self_invoice" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-foreach='docs']" position="inside">
            <t t-set="is_self_invoice" t-value="o.set_self_invoice" />
        </xpath>
    </template>
</odoo>
